---
import type IWorkItem from "../types/IWorkItem";
import WorkCard from "./WorkCard.astro";

const { title, description, sections } = Astro.props;
---
<section class="bg-white py-16 sm:py-32">
  <div class="container">
    <h1 class="text-center sm:text-left text-purple text-3xl md:text-5xl font-bold">{ title }</h1>
    <p class="text-center sm:text-left mt-4 sm:px-0 w-full max-w-xl text-lg md:text-xl mb-8 sm:mb-10">{description}</p>
    <div class="flex flex-col sm:flex-row justify-between gap-6 lg:gap-12">
      {sections.map((section: IWorkItem) => (
        <WorkCard {...section} />
      ))}
    </div>
  </div>
</section>